layout {

    focus-ring {
        active-color   "#8b9fc1"
        inactive-color "#1a1d23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8b9fc1"
        inactive-color "#1a1d23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1a1d2370"
    }

    tab-indicator {
        active-color   "#8b9fc1"
        inactive-color "#2a4470"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8b9fc180"
    }
}

recent-windows {
    highlight {
        active-color "#8b9fc1"
        urgent-color "#fd4663"
    }
}
