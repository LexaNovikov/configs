configuration {
    modi: "run,drun,window";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-entry: ">>";
    display-drun: ">>";
    display-run: ">>";
    display-window: ">>";
    sidebar-mode: false;
}

@theme "/dev/null"

* {
    bg-col:  #271D1C;
    mbg: rgba(0, 0, 0, 0.2);
    bg-col-light: #271D1C;
    border-col: rgba(162,198,222, 1);
    selected-col: #4A3532;
    blue: rgba(117,213,239, 0.7);
    fg-col: #ffffff;
    fg-col2: #f38ba8;
    grey: #6c7086;

    width: 600;
    font: "JetBrainsMono Nerd Font 16";
    
}

element-text, element-icon , mode-switcher {
    background-color: rgba(255,255,255,0);
    text-color: inherit;
}

window {
    height: 400px;
    border: 2px;
    border-color: @border-col;
    background-color: @mbg;
    border-radius: 15px; /* Скругление самого окна */
}

mainbox {
    children: [ inputbar, listview ];
    background-color: @mbg;
    
}

inputbar {
    enabled: true;
    spacing: 10px;
    padding: 10px 20px; /* Отступы внутри строки поиска */
    children: [ prompt, entry ];
    background-color: rgba(25, 25, 25, 0);
}

prompt {
    enabled: true;
    content: ">>"; /* Явно задаем текст */
    text-color:@blue;
    vertical-align: 0.5;
    background-color: rgba(25, 25, 25, 0);
}

entry {
    enabled: true;
    vertical-align: 0.5;
    background-color: rgba(25, 25, 25, 0);
    text-color:white;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 0px 20px 0px 20px;
    columns: 1;
    lines: 5;
    background-color: rgba(25, 25, 25, 0);
}

element {
    padding: 12px;
    background-color: rgba(25, 25, 25, 0);
    text-color: rgba(220,220,220,1);
}

element-icon {
    size: 25px;
}

element selected {
    background-color:rgba(255,255,255,0.15);
    text-color: rgba(255,255,255,1);
    border-radius: 16px; /* ТО САМОЕ СКРУГЛЕНИЕ ВЫДЕЛЕНИЯ */
}

mode-switcher {
    spacing: 0;
  }

button {
    padding: 10px;
    background-color:rgba(255,255,255,0);
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
  background-color:rgba(255,255,255,1);
  text-color: @blue;
}

